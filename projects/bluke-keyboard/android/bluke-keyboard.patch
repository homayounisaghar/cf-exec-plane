+package dev.arnv.bluke.ui
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Test
+
+class PersianCharacterLayoutTest {
+    @Test
+    fun persianStandardShowsPersianLegendsAtStandardPhysicalPositions() {
+        val keys = KeyboardLayouts.getLayout(
+            KeyboardGeometry.COMPACT_75,
+            KeyboardCharacterLayout.PERSIAN_STANDARD,
+        ).flatten()
+
+        assertEquals("ض", keys.single { it.physicalKeyCode == KeyboardLayouts.KEY_Q }.legend)
+        assertEquals("ص", keys.single { it.physicalKeyCode == KeyboardLayouts.KEY_W }.legend)
+        assertEquals("ف", keys.single { it.physicalKeyCode == KeyboardLayouts.KEY_T }.legend)
+        assertEquals("ش", keys.single { it.physicalKeyCode == KeyboardLayouts.KEY_A }.legend)
+        assertEquals("ل", keys.single { it.physicalKeyCode == KeyboardLayouts.KEY_G }.legend)
+        assertEquals("پ", keys.single { it.physicalKeyCode == KeyboardLayouts.KEY_M }.legend)
+        assertEquals(KeyboardLayouts.KEY_Q, keys.single { it.physicalKeyCode == KeyboardLayouts.KEY_Q }.keyCode)
+    }
+
+    @Test
+    fun persianDigitsAndShiftedSymbolsAreDisplayed() {
+        val keys = KeyboardLayouts.getLayout(
+            KeyboardGeometry.COMPACT_75,
+            KeyboardCharacterLayout.PERSIAN_STANDARD,
+        ).flatten()
+        assertEquals("۱", keys.single { it.physicalKeyCode == KeyboardLayouts.KEY_1 }.legend)
+        assertEquals("!", keys.single { it.physicalKeyCode == KeyboardLayouts.KEY_1 }.shiftedLegend)
+        assertEquals("۰", keys.single { it.physicalKeyCode == KeyboardLayouts.KEY_0 }.legend)
+    }
+
+    @Test
+    fun hostLayoutIdentifiersMapOnlySupportedLayouts() {
+        assertEquals(
+            KeyboardCharacterLayout.PERSIAN_STANDARD,
+            KeyboardCharacterLayout.fromHostPreference("fa_persian_standard"),
+        )
+        assertEquals(
+            KeyboardCharacterLayout.US_QWERTY,
