diff --git a/app/src/main/java/dev/arnv/bluke/bluetooth/HostLanguageServer.kt b/app/src/main/java/dev/arnv/bluke/bluetooth/HostLanguageServer.kt
new file mode 100644
index 0000000..c017d0e
--- /dev/null
+++ b/app/src/main/java/dev/arnv/bluke/bluetooth/HostLanguageServer.kt
@@ -0,0 +1,147 @@
+package dev.arnv.bluke.bluetooth
+
+import android.util.Log
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import org.json.JSONObject
+import java.io.BufferedReader
+import java.io.BufferedWriter
+import java.io.InputStreamReader
+import java.io.OutputStreamWriter
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.ServerSocket
+import java.net.Socket
+import java.net.SocketException
+
+/**
+ * Receives only the active Windows keyboard-layout identifier.
+ * Keystrokes remain on Bluetooth HID; this channel never carries typed text.
+ */
+class HostLanguageServer {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val _layoutPreference = MutableStateFlow<String?>(null)
+    val layoutPreference: StateFlow<String?> = _layoutPreference.asStateFlow()
+
+    private val _status = MutableStateFlow("Waiting for permission")
+    val status: StateFlow<String> = _status.asStateFlow()
+
+    @Volatile private var serverSocket: ServerSocket? = null
+    @Volatile private var clientSocket: Socket? = null
+    private var serverJob: Job? = null
+
+    @Synchronized
+    fun start() {
+        if (serverJob?.isActive == true) return
+        _status.value = "Starting"
+        serverJob = scope.launch { runServer() }
+    }
+
+    private suspend fun runServer() {
+        val coroutineContext = currentCoroutineContext()
+        while (coroutineContext.isActive) {
+            var server: ServerSocket? = null
+            try {
+                _status.value = "Starting"
+                server = ServerSocket().apply {
+                    reuseAddress = true
+                    bind(InetSocketAddress(InetAddress.getByName("0.0.0.0"), PORT), 2)
+                }
+                serverSocket = server
+                _status.value = "Listening on $PORT"
+                Log.i(TAG, "Host-language bridge listening on 0.0.0.0:$PORT")
+
+                while (coroutineContext.isActive) {
+                    val client = server.accept()
+                    clientSocket = client
+                    _status.value = "Windows connected"
+                    Log.i(TAG, "Windows host connected from ${client.inetAddress.hostAddress}")
+                    try {
+                        handleClient(client)
+                    } catch (e: Exception) {
+                        if (coroutineContext.isActive) Log.w(TAG, "Host-language client ended", e)
+                    } finally {
+                        clientSocket = null
+                        runCatching { client.close() }
+                        if (coroutineContext.isActive) _status.value = "Listening on $PORT"
+                    }
+                }
+            } catch (e: Exception) {
+                if (coroutineContext.isActive) {
+                    _status.value = "Error: ${e.javaClass.simpleName}"
+                    Log.e(TAG, "Host-language server failed", e)
+                    delay(RETRY_DELAY_MS)
+                }
+            } finally {
+                runCatching { server?.close() }
+                if (serverSocket === server) serverSocket = null
+            }
+        }
+        _status.value = "Stopped"
+    }
+
+    private fun handleClient(client: Socket) {
+        client.tcpNoDelay = true
+        val reader = BufferedReader(InputStreamReader(client.getInputStream(), Charsets.UTF_8))
+        val writer = BufferedWriter(OutputStreamWriter(client.getOutputStream(), Charsets.UTF_8))
+        while (!client.isClosed) {
+            val line = reader.readLine() ?: break
+            if (line.length > MAX_MESSAGE_LENGTH) break
+            val layout = parseLayoutPreference(line)
+            val response = JSONObject()
+            if (layout != null) {
+                _layoutPreference.value = layout
+                response.put("ok", true)
+                response.put("layout", layout)
+            } else {
+                response.put("ok", false)
+            }
+            writer.write(response.toString())
+            writer.newLine()
+            writer.flush()
+        }
+    }
+
+    internal fun parseLayoutPreference(line: String): String? {
+        if (line.length > MAX_MESSAGE_LENGTH) return null
+        val trimmed = line.trim()
+        if (!trimmed.startsWith("{") || !trimmed.endsWith("}")) return null
+        val protocol = JSON_STRING_FIELD.find(trimmed)?.groupValues?.get(2)
+        if (protocol != PROTOCOL) return null
+        val layout = LAYOUT_STRING_FIELD.find(trimmed)?.groupValues?.get(2)
+        return layout?.takeIf(SUPPORTED_LAYOUTS::contains)
+    }
+
+    @Synchronized
+    fun stop() {
+        runCatching { clientSocket?.close() }
+        runCatching { serverSocket?.close() }
+        clientSocket = null
+        serverSocket = null
+        serverJob?.cancel()
+        serverJob = null
+        _status.value = "Stopped"
+    }
+
+    companion object {
+        const val PORT = 39472
+        private const val TAG = "BlukeHostLanguage"
+        private const val PROTOCOL = "bluke-language-v1"
+        private const val MAX_MESSAGE_LENGTH = 1024
+        private const val RETRY_DELAY_MS = 1500L
+        private val JSON_STRING_FIELD = Regex("""("protocol"\s*:\s*"([^"\\]*)")""")
+        private val LAYOUT_STRING_FIELD = Regex("""("layout"\s*:\s*"([^"\\]*)")""")
+        private val SUPPORTED_LAYOUTS = setOf(
+            "us_qwerty", "fr_azerty", "de_qwertz", "ru_jcuken", "fa_persian_standard",
+        )
+    }
+}
