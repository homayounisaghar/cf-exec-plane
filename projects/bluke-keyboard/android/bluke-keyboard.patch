diff --git a/app/src/main/java/dev/arnv/bluke/bluetooth/HostLayoutReport.kt b/app/src/main/java/dev/arnv/bluke/bluetooth/HostLayoutReport.kt
new file mode 100644
index 0000000..10aa89d
--- /dev/null
+++ b/app/src/main/java/dev/arnv/bluke/bluetooth/HostLayoutReport.kt
@@ -0,0 +1,24 @@
+package dev.arnv.bluke.bluetooth
+
+internal const val HOST_LAYOUT_REPORT_ID = 5
+
+/**
+ * Maps the one-byte vendor-defined Bluetooth HID output report sent by Windows.
+ * Codes: 0=US, 1=French, 2=German, 3=Russian, 4=Persian.
+ */
+internal fun hostLayoutPreferenceFromReport(reportId: Int, data: ByteArray): String? {
+    if (reportId != HOST_LAYOUT_REPORT_ID || data.isEmpty()) return null
+    val code = if (data.size >= 2 && (data[0].toInt() and 0xFF) == HOST_LAYOUT_REPORT_ID) {
+        data[1].toInt() and 0xFF
+    } else {
+        data[0].toInt() and 0xFF
+    }
+    return when (code) {
+        0 -> "us_qwerty"
+        1 -> "fr_azerty"
+        2 -> "de_qwertz"
+        3 -> "ru_jcuken"
+        4 -> "fa_persian_standard"
+        else -> null
+    }
+}
