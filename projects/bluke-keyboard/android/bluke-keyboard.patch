@@ -0,0 +1,28 @@
+package dev.arnv.bluke.bluetooth
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class HostLanguageServerTest {
+    private val server = HostLanguageServer()
+
+    @Test
+    fun acceptsPersianAndEnglishLayoutMessages() {
+        assertEquals(
+            "fa_persian_standard",
+            server.parseLayoutPreference("""{"protocol":"bluke-language-v1","layout":"fa_persian_standard"}"""),
+        )
+        assertEquals(
+            "us_qwerty",
+            server.parseLayoutPreference("""{"protocol":"bluke-language-v1","layout":"us_qwerty"}"""),
+        )
+    }
+
+    @Test
+    fun rejectsUnknownProtocolAndUnlistedLayouts() {
+        assertNull(server.parseLayoutPreference("""{"protocol":"other","layout":"us_qwerty"}"""))
+        assertNull(server.parseLayoutPreference("""{"protocol":"bluke-language-v1","layout":"fr"}"""))
+        assertNull(server.parseLayoutPreference("not-json"))
+    }
+}
