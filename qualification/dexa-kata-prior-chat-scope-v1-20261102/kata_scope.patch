+def verified_prior_bullet_title_in_owner_task(task: str, reply: str | None) -> bool:
+    """A name copied from the last VERIFIED owner-visible list is a provider hint,
+    never an identity/handle or permission for a write. Other history is ignored."""
+    if not isinstance(reply, str) or "•" not in reply:
+        return False
+    for raw in reply.split("•")[1:]:
+        title = raw.strip().splitlines()[0].strip()
+        title = re.sub(r"\s*[（(][^()（）]{0,80}[)）]\s*$", "", title).strip()
+        if not 4 <= len(title) <= 120:
+            continue
+        if re.search(r"(?<!\w)" + re.escape(title) + r"(?!\w)", task, re.IGNORECASE):
+            return True
+    return False
+
