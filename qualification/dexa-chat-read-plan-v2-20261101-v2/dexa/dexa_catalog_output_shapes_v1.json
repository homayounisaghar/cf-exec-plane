          "identityAuthority": "PROVIDER_OBSERVED_NAME_ONLY_NO_STABLE_HANDLE"
        }
      }
    },
    "wechat_file_send": {
      "identityInputs": {
        "target": {
          "kind": "NATIVE_UNIQUE_EXACT_LABEL",
          "sourceCollection": "conversations",
          "sourceField": "name",
          "sourceRecordFamily": "conversation",
          "requiredMatchModes": [
            "normalized_exact",
            "bilingual_exact"
          ],
          "nativeOperationVerifiesUniqueExactRecipient": true,
          "nativeProofBasis": "CF_SCHEMA_TARGET_EXACT_CHAT_AND_UNIQUE_NATIVE_CHOOSER",
          "neverTrustCanonicalIdentityForWrite": true
        }
      }
    },
    "wechat_unread_list": {
