    "wechat_conversation_list": {
      "arrays": {
        "conversations": {
          "fields": [
            "conversation_ref",
            "name",
            "identity_strength",
            "duplicate_name_safe",
            "selected",
            "unread_count",
            "has_unread",
            "read_state",
            "muted",
            "pinned",
            "timestamp",
            "preview",
