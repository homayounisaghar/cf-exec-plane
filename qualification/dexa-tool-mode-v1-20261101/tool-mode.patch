+test('one durable same-prompt model retry admits a plain TOOL after MODE_FIELDS_INVALID',async()=>{
+ const {compileFastGeneralMissionPlan,STRUCTURAL_RETRY_CODES}
+  =await import('./dexa_general_plan_cycle_v2.mjs');
+ assert.equal(STRUCTURAL_RETRY_CODES.has('TOOL_PLAN_MODE_FIELDS_INVALID'),true);
+ assert.equal(STRUCTURAL_RETRY_CODES.has('GENERAL_PLAN_IDENTITY_NOT_PROVIDER_GROUNDED'),false);
+ const good=plan(),bad=structuredClone(good);
+ bad.steps[2].source={step:2,path:[]}; // forbidden on an ordinary TOOL
+ let calls=0,retries=0,firstPrompt=null;
+ const result=await compileFastGeneralMissionPlan({
+  goal:'Find latest verified video in Owner Notes',
+  kataCapabilityIds:allowed,
+  askModel:async prompt=>{
+   calls++;
+   if(calls===1)firstPrompt=prompt;
+   else assert.equal(prompt,firstPrompt);
+   return{recipe:JSON.stringify({schema:'dexa.owner-decision.v1',
+    decision:'EXECUTE',plan:calls===1?bad:good}),model:'fixture'};
+  },claimStructuralRetry:async({validationCode,modelCallCount})=>{
+   retries++;
+   assert.equal(validationCode,'TOOL_PLAN_MODE_FIELDS_INVALID');
+   assert.equal(modelCallCount,1);
+   return true;
+  },onProgress:async()=>{}
+ });
+ assert.equal(calls,2);
+ assert.equal(retries,1);
+ assert.equal(result.decision,'SELECT');
+ assert.equal(result.parsed.steps.length,7);
+ assert.deepEqual(result.parsed.steps[3].source.path,['canonical_messages']);
+ assert.equal(result.selected.length,2);
+});
