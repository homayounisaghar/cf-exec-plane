 // Kata admission. They allow the single Qwen brain to consult a second
 // documented provider view if a title/alias is not indexed in the first.
 // No lookup is executed here, no free-text aliases, no re-ranking.
+// Catalog-derived completion for a selected message search/read family.
+// A provider's message search may not retrieve its latest message in an
+// observed conversation. Keep the documented message-list alternative in the
+// SAME original Kata shortlist. This authorizes no provider execution, no
+// guessed identity and no new provider family.
+export function compatibleMessageReadAlternatives({selected,allowed}={}){
+ if(!Array.isArray(selected)||!Array.isArray(allowed))
+  throw error('CATALOG_MESSAGE_ALTERNATIVE_INPUT_INVALID');
+ const permitted=new Set(allowed);
+ const selectedSet=new Set(selected);
+ const byNative=new Map();
+ for(const id of allowed){
+  const native=catalogRoute(id)?.cfName;
+  if(typeof native==='string')byNative.set(native,id);
+ }
+ const providers=new Set();
+ for(const id of selected){
+  if(!permitted.has(id))continue;
+  const route=catalogRoute(id);
+  if(!route?.isReadOnly||route.requiresElevation)continue;
+  const match=/^(.+)_message_(?:search|get)$/.exec(route.cfName||'');
+  if(match)providers.add(match[1]);
+ }
+ const result=[];
+ for(const provider of providers){
+  const id=byNative.get(provider+'_message_list');
+  if(!id||selectedSet.has(id))continue;
+  const route=catalogRoute(id);
+  const schema=inputSchemaFor(id);
+  const output=catalogKnownOutputShape(id);
+  const required=schema?.required||[];
+  // A real messages[] output and real provider conversation/target input
+  // prevent confusing a generic search with an eligible message reader.
+  if(!route?.cfName||!Array.isArray(output?.arrays?.messages?.fields)||
+     !output.arrays.messages.fields.some(f=>['body','text','content'].includes(f))||
+     !required.some(f=>['conversation','target','recipient'].includes(f)))
+   continue;
+  result.push(id);
+ }
+ return Object.freeze(result.slice(0,6));
+}
