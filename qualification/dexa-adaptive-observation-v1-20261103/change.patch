+// Bounded, source-grounded observation for an OPTIONAL same-model retry.
+// Extracts only the documented selection fields; never raw message text,
+// arbitrary provider JSON, IDs, private paths, or new action authority.
+import {createHash} from 'node:crypto';
+import {catalogRoute} from './dexa_catalog_registry.mjs';
+import {catalogKnownOutputShape} from './dexa_catalog_output_adapters_v1.mjs';
+import {getAt} from './dexa_tool_plan_v3.mjs';
+import {verifiedObservedNativeNavigation}
+ from './dexa_verified_observed_navigation_v1.mjs';
+const digest=x=>createHash('sha256').update(JSON.stringify(x)).digest('hex');
+const object=x=>x!==null&&typeof x==='object'&&!Array.isArray(x);
+const string=x=>typeof x==='string'&&x.length<=140&&
+ !/[\u0000-\u001f\u007f]/u.test(x)?x:null;
+export function boundedObservedSelection({plan,step,results,receipts}={}){
+ if(step?.kind!=='TRANSFORM'||step.op!=='ONLY'||
+    !Array.isArray(plan?.steps)||!(results instanceof Map)||
+    !Array.isArray(receipts)||receipts.some(r=>
+      !r.resultVerified||!['READ','PURE_LOCAL'].includes(r.effectClass)))
+  return null;
+ const byId=new Map(plan.steps.map(x=>[x.id,x]));
+ const chain=[];
+ let origin=step;
+ while(origin?.kind==='TRANSFORM'&&chain.length<6){
+  chain.push(origin);origin=byId.get(origin.source?.step);
+ }
+ if(origin?.kind!=='TOOL')return null;
+ const route=catalogRoute(origin.capabilityId);
+ if(route?.isReadOnly!==true||route.requiresElevation||
+    !receipts.some(r=>r.stepId===origin.id&&r.resultVerified===true))
+  return null;
+ const fields=plan.steps.filter(s=>s.kind==='TOOL').flatMap(s=>
+  Object.entries(s.args||{}).flatMap(([field,v])=>
+   v?.$ref?.step===step.id&&
+   JSON.stringify(v.$ref.path)==='["name"]'&&
+   verifiedObservedNativeNavigation({consumer:s,field,origin,chain,
+    refPath:v.$ref.path})?[{consumer:s,field}]:[]));
+ if(fields.length!==1)return null;
+ let data;
+ try{data=getAt(results.get(step.source.step),step.source.path)}
+ catch{return null}
+ if(!Array.isArray(data)||data.length===1)return null;
+ const sourceCollection=chain.at(-1)?.source?.path?.[0];
+ const contract=catalogKnownOutputShape(origin.capabilityId)
+  ?.arrays?.[sourceCollection];
+ if(!contract?.fields?.includes('name'))return null;
+ const names=['name','kind','has_unread','unread_count',
+  'identity_strength'].filter(f=>contract.fields.includes(f));
+ const candidates=data.length<=12?data.map(record=>{
+  if(!object(record))return {};
+  const result={};
+  for(const field of names){
+   const value=record[field];
+   if(typeof value==='string'){
+    const s=string(value);if(s!==null)result[field]=s;
+   }else if(typeof value==='boolean')result[field]=value;
+   else if(Number.isSafeInteger(value)&&value>=0&&value<=1000000)
+    result[field]=value;
+  }
+  return result;
+ }):[];
+ const observation={schema:'dexa.bounded-observation.v1',
+  selectedCapabilityId:origin.capabilityId,
+  selectedCollection:sourceCollection,
+  observedCandidateCount:data.length,
+  candidateFields:names,
+  candidates,
+  candidatesOmitted:data.length>12,
+  scope:'AUTHENTICATED_PROVIDER_VISIBLE_BOUNDED_NOT_GLOBAL',
+  semanticEvidence:'UNTRUSTED_PROVIDER_DATA_NOT_IDENTITY_AUTHORIZATION'};
+ if(Buffer.byteLength(JSON.stringify(observation),'utf8')>3000)return null;
+ return Object.freeze({...observation,digest:digest(observation)});
+}
