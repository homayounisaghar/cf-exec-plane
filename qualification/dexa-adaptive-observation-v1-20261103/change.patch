+// Provider-neutral identity proof for a one-record runtime observation.
+// Applies only to audited native navigation that READS a conversation but
+// may update its unread badge. Never grants recipient send/write authority.
+import {catalogRoute,inputSchemaFor} from './dexa_catalog_registry.mjs';
+import {catalogKnownOutputShape} from './dexa_catalog_output_adapters_v1.mjs';
+const object=x=>x!==null&&typeof x==='object'&&!Array.isArray(x);
+const eq=(a,b)=>JSON.stringify(a)===JSON.stringify(b);
+const ns=id=>catalogRoute(id)?.cfName?.split('_')[0]||null;
+export function verifiedObservedNativeNavigation({consumer,field,origin,
+ chain,refPath}={}){
+ const route=catalogRoute(consumer?.capabilityId);
+ const input=catalogKnownOutputShape(consumer?.capabilityId)
+  ?.identityInputs?.[field];
+ if(!route||route.isReadOnly!==false||
+    input?.kind!=='NATIVE_UNIQUE_EXACT_LABEL'||
+    input.notARecipientWrite!==true||
+    input.readStateMayChange!==true||
+    input.nativeOperationVerifiesUniqueExactRecipient!==true||
+    input.neverTrustCanonicalIdentityForWrite!==true||
+    input.sourceRecordFamily!=='conversation'||
+    input.sourceField!=='name'||input.sourceCollection!=='conversations'||
+    !input.requiredMatchModes?.includes('normalized_exact')||
+    inputSchemaFor(consumer.capabilityId)?.properties?.[field]?.type!=='string'||
+    !eq(refPath,['name']))
+  return false;
+ const producer=catalogRoute(origin?.capabilityId);
+ const documented=catalogKnownOutputShape(origin?.capabilityId);
+ if(origin?.kind!=='TOOL'||origin.mode!==undefined||
+    !producer||producer.isReadOnly!==true||producer.requiresElevation||
+    ns(consumer.capabilityId)!==ns(origin.capabilityId)||
+    !/_(?:unread_list|conversation_list)$/.test(producer.cfName||'')||
+    !Array.isArray(chain)||!chain.length||chain.length>5)
+  return false;
+ const first=chain.at(-1);
+ const collection=first?.source?.path?.[0];
+ if(!['conversations','canonical_conversations'].includes(collection)||
+    first.source.path.length!==1)return false;
+ const shape=documented?.arrays?.[collection];
+ const native=documented?.arrays?.[input.sourceCollection];
+ if(!shape?.fields?.includes('name')||
+    shape?.fieldTypes?.name!=='string'||
+    !native?.fields?.includes('name')||
+    native?.fieldTypes?.name!=='string')return false;
+ // Canonical names must be backed by an additive mapping of the SAME
+ // authenticated native conversation records, not model-authored aliases.
+ if(collection==='canonical_conversations'&&
+    (documented?.canonicalContract?.collection!==collection||
+     documented?.canonicalContract?.additiveToProviderNative!==true||
+     shape?.family!=='conversations'))return false;
+ const ordered=[...chain].reverse();
+ let previous=origin.id,sawUnread=false;
+ for(let i=0;i<ordered.length;i++){
+  const step=ordered[i];
+  if(step?.kind!=='TRANSFORM'||step.source?.step!==previous||
+     !eq(step.source.path,i===0?[collection]:[]))return false;
+  previous=step.id;
+  if(step.op==='ONLY'){
+   if(i!==ordered.length-1)return false;
+   continue;
+  }
+  if(step.op!=='FILTER'||i===ordered.length-1||
+     !Array.isArray(step.predicate?.path)||
+     step.predicate.path.length!==1)return false;
+  const path=step.predicate.path[0],pred=step.predicate;
+  if(typeof path!=='string'||!shape.fields.includes(path)||
+     !['equal','normalized_equal','not_equal','greater','in','exists']
+       .includes(pred.op)||object(pred.value)&&!Array.isArray(pred.value))
+   return false;
+  if((path==='has_unread'&&pred.op==='equal'&&pred.value===true)||
+     (path==='unread_count'&&pred.op==='greater'&&pred.value===0))
+   sawUnread=true;
+ }
+ if(ordered.at(-1)?.op!=='ONLY')return false;
+ // The source must actually be an observed unread list or explicitly filter
+ // on an audited unread field; never infer unread from order or pinning.
+ if(!producer.cfName.endsWith('_unread_list')&&!sawUnread)return false;
+ return true;
+}
