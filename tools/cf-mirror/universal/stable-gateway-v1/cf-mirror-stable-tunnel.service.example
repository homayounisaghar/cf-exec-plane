# Requires an OWNER-created Cloudflare Tunnel in same Cloudflare account as Worker.
# Put the tunnel token in the private 0600 file referenced below.
[Unit]
Description=Cloudflare QUIC Tunnel for CF Universal Mirror Workers VPC
After=network-online.target cf-mirror-stable-broker.service
Wants=network-online.target
Requires=cf-mirror-stable-broker.service

[Service]
Type=simple
ExecStart=/home/cfserver/pocket-farsi-stream-mvp/cloudflared tunnel --no-autoupdate --protocol quic run --token-file /home/cfserver/.config/cf-mirror-stable-vpc-token
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
